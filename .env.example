# contoh config — copy jadi .env lalu isi (JANGAN commit .env)
PORT=3000
COUCH_URL=https://livesync.srv1167690.hstgr.cloud
COUCH_DB=obsidiannotes
COUCH_USER=dashboard-reader
COUCH_PASS=ganti-dengan-password-couchdb
# Passphrase enkripsi vault (wajib di hosting tanpa file vault — mode CouchDB terdekripsi)
VAULT_PASSPHRASE=
# Folder vault lokal (opsional). Kalau ada, dipakai sebagai sumber; kalau tidak ada,
# server otomatis baca + dekripsi dari CouchDB (butuh VAULT_PASSPHRASE).
VAULT_DIR=
